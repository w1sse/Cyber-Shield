# Скопируйте этот файл в .env и впишите свои ключи.
# .env никому не показывайте и не выкладывайте на GitHub. В ЭТОМ файле (.env.example) ключей быть не должно.
SAFE_BROWSING_KEY=
VIRUSTOTAL_KEY=
PORT=8000
HOST=127.0.0.1
PHONE_SALT=придумайте-любую-длинную-строку
# Если сайт открыт по HTTPS, поставьте 1
SECURE_COOKIES=0
